        {"id": "kp01-02", "name": "与裸向量库/RAG/Claude Code auto memory 的本质差异", "type": "design"},
        {"id": "kp01-03", "name": "与 Zep/Letta/LangMem 的选型判据", "type": "design"}
      ]
    },
